{
  "buildCommand": null,
  "outputDirectory": ".",
  "headers": [
    {"source": "/(.*)", "headers": [{"key": "X-Content-Type-Options", "value": "nosniff"}, {"key": "Referrer-Policy", "value": "same-origin"}]},
    {"source": "/(index.html|config.js|app.js)", "headers": [{"key": "Cache-Control", "value": "no-cache"}]}
  ]
}
